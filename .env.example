# Local dev needs none of these; the CMS writes straight to ./content.

# Production: make /keystatic commit to GitHub instead of the local filesystem.
NEXT_PUBLIC_KEYSTATIC_STORAGE=github
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=owner/repo

# Created by the Keystatic GitHub App setup flow (visit /keystatic once with the two vars above set).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# The contact form (/api/contact) sends through Resend.
RESEND_API_KEY=
# Optional: where notes go (defaults to the email link in content/site.yaml) and who they're from
# (must be on a domain verified with Resend; onboarding@resend.dev only reaches the account owner).
CONTACT_TO=
CONTACT_FROM=
